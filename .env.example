# ==============================================
# アプリケーション設定
# ==============================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# ==============================================
# Docker設定
# ==============================================
# PHP設定ファイル: local.ini / dev.ini / staging.ini / prod.ini
PHP_INI=local.ini

# 再起動ポリシー: unless-stopped / always / no
RESTART_POLICY=unless-stopped

# ボリュームオプション: (空白=読み書き可) / :ro (読み取り専用)
VOLUME_OPTIONS=

# Xdebugインストール: true / false
INSTALL_XDEBUG=false

# ==============================================
# 言語・ロケール設定
# ==============================================
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

# ==============================================
# メンテナンスモード
# ==============================================
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ==============================================
# セキュリティ設定
# ==============================================
BCRYPT_ROUNDS=12

# ==============================================
# ログ設定
# ==============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================
# データベース設定
# ==============================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# ==============================================
# セッション設定
# ==============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==============================================
# ブロードキャスト・ストレージ・キュー
# ==============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# ==============================================
# キャッシュ設定
# ==============================================
CACHE_STORE=redis
CACHE_PREFIX=laravel_cache

# ==============================================
# Redis設定
# ==============================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================
# Memcached設定
# ==============================================
MEMCACHED_HOST=127.0.0.1

# ==============================================
# メール設定
# ==============================================
# ローカル開発: log または smtp (Mailhog使用時)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# 開発ツール用ポート設定
# ==============================================
# Mailhog (メールテスト)
MAILHOG_PORT=8025
MAILHOG_SMTP_PORT=1025

# phpMyAdmin (データベース管理)
PHPMYADMIN_PORT=8080

# Redis Commander (Redis管理)
REDIS_COMMANDER_PORT=8081

# ==============================================
# AWS設定
# ==============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================
# Pusher設定 (リアルタイム通信)
# ==============================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ==============================================
# Vite設定 (フロントエンド)
# ==============================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ==============================================
# サードパーティサービス設定
# ==============================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Stripe (決済)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Sentry (エラー追跡)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ==============================================
# パフォーマンス設定
# ==============================================
# PHP CLI Server Workers (並列処理数)
# PHP_CLI_SERVER_WORKERS=4

# OPcache設定 (本番環境で有効化推奨)
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=10000
